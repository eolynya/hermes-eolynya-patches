+    @staticmethod
+    def _normalize_reply_to_mode(value: Any) -> str:
+        """Normalize reply_to_mode config into 'off' | 'first' | 'all'.
+
+        Accepts the string forms used by other platform adapters ("off",
+        "first", "all") and the boolean form that ``hermes config set
+        platforms.feishu.reply_to_mode off`` writes to YAML (False).
+        """
+        if value is False or value is True:
+            return "off" if value is False else "first"
+        raw = str(value or "").strip().lower()
+        if raw in {"off", "false", "no", "0"}:
+            return "off"
+        if raw in {"all", "every"}:
+            return "all"
+        return "first"
+
