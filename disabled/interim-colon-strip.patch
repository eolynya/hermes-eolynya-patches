+# Kaomoji freshness enforcement for interim messages. The model often reaches
+# for a favourite expression on every message; track the last kaomoji used per
+# chat and swap a repeat for a different one so consecutive interim messages
+# never carry the same face. Wrapped in try/except so a regex hiccup can never
+# break the interim send path.
+_INTERIM_KAOMOJI_POOL = (
+    "(｡•̀ᴗ-)✧", "(◕‿◕)", "ヽ(>∀<☆)ノ", "(≧▽≦)", "(๑˃ᴗ˂)ﻭ", "(・∀・)",
+    "♪", "(｡･ω･｡)", "(＾▽＾)", "(ᵔᴥᵔ)", "(•̀ᴗ•́)و", "(◍•ᴗ•◍)✧",
+    "(๑•̀ㅂ•́)و✧", "₍ᐢ. .ᐢ₎", "(´｡• ᵕ •｡`)", "(￣▽￣)ノ", "(◕‿◕✿)",
+    "(≧◡≦)", "(｡♥‿♥｡)", "(ﾉ◕ヮ◕)ﾉ*:・ﾟ✧", "(つ≧▽≦)つ", "(⌒▽⌒)☆",
+    "(｡>ㅅ<｡)", "(っ˘ω˘ς)", "(人 •͈ᴗ•͈)", "٩(◕‿◕)۶", "(づ｡◕‿‿◕｡)づ",
+)
+_INTERIM_KAOMOJI_RE = re.compile(
+    r"[\(（][^\s\(\)（）]{1,12}[\)）][★♪☆✧❤♡]?|(?:ノ|ヽ|へ)[^ ]{0,2}[ノヽ]?|[★♪☆✧❤♡]",
+)
+_last_interim_kaomoji: Dict[str, str] = {}
+
+
+def _dedupe_interim_kaomoji(text: str, chat_id: Any) -> str:
+    """Replace a kaomoji that repeats the previous interim message's one.
+
+    Returns text unchanged when no kaomoji is found or nothing repeats.
+    """
+    try:
+        if not text:
+            return text
+        match = _INTERIM_KAOMOJI_RE.search(text)
+        if not match:
+            return text
+        used = match.group(0)
+        prev = _last_interim_kaomoji.get(str(chat_id))
+        if used == prev and prev is not None:
+            replacement = next(
+                (k for k in _INTERIM_KAOMOJI_POOL if k != used),
+                "",
+            )
+            text = text.replace(used, replacement, 1)
+        else:
+            _last_interim_kaomoji[str(chat_id)] = used
+        return text
+    except Exception:
+        return text
+
+
