diff --git a/gateway/run_busy.py b/gateway/run_busy.py
index 2688b957e3..72b79fc63a 100644
--- a/gateway/run_busy.py
+++ b/gateway/run_busy.py
@@ -653,6 +653,27 @@ class GatewayBusySessionMixin:
             logger.debug("Failed to send busy-ack: %s", e)
 
     async def _handle_active_session_busy_message(self, event: MessageEvent, session_key: str) -> bool:
+        # ── Auto-reply / absence-message filter (busy path) ────────────────
+        # The cold path (_hm_admit_event) drops "[自动回复]" messages, but a busy
+        # agent routes follow-ups through steer/queue/interrupt BEFORE the next
+        # cold-path call — so an auto-reply would still be injected into the
+        # running agent and echoed. Filter here too so busy-path auto-replies
+        # are equally silently dropped. Marker: _ignore_auto_reply_filter
+        if not bool(getattr(event, "internal", False)):
+            try:
+                from gateway.run import _AUTO_REPLY_PREFIXES
+
+                _steer_auto = (getattr(event, "text", "") or "").strip()
+                if _steer_auto.startswith(_AUTO_REPLY_PREFIXES):
+                    logger.info(
+                        "Dropping auto-reply in busy path from platform %s (id=%s)",
+                        getattr(event.source, "platform", "?"),
+                        getattr(event, "message_id", "?"),
+                    )
+                    return True  # handled (silently dropped); do not steer/queue
+            except Exception:
+                logger.debug("busy auto-reply filter skipped", exc_info=True)
+
         # Gateway wakes have no external user identity. Admit them before auth/drain/approval
         # handling, without merging their text into an already queued human message.
         if event.internal and event.allow_gateway_control:
