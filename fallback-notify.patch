diff --git a/agent/chat_completion_helpers.py b/agent/chat_completion_helpers.py
index 3b7d8b0..6be332d 100644
--- a/agent/chat_completion_helpers.py
+++ b/agent/chat_completion_helpers.py
@@ -1660,6 +1660,24 @@ def rewrite_prompt_model_identity(agent, model: str, provider: str) -> None:
         if matches:
             last = matches[-1]
             sp = f"{sp[:last.start()]}{label}: {value}{sp[last.end():]}"
+    # When the agent is running as a fallback (primary provider failed and
+    # this model was pulled in as backup), tell it so — otherwise it has no
+    # idea it is the substitute and can misreport state (e.g. claim it saw
+    # "no fallback happened").  Only annotate when a fallback is actually
+    # active; the annotation is dropped naturally when the primary runtime is
+    # restored and the cached prompt is rebuilt from the stored copy.
+    if getattr(agent, "_fallback_activated", False):
+        _fb_note = (
+            "\n\n[System note: You are currently running as a FALLBACK model. "
+            "The primary provider ("
+            + str(getattr(agent, "_primary_runtime", {}).get("provider") or "primary")
+            + "/"
+            + str(getattr(agent, "_primary_runtime", {}).get("model") or "model")
+            + ") is unavailable, so this turn is being answered by "
+            + f"{provider}/{model}. If asked, state this clearly.]"
+        )
+        if _fb_note not in sp:
+            sp = sp + _fb_note
     agent._cached_system_prompt = sp
 
 
